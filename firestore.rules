rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isCallParty() {
      return signedIn() &&
        (
          resource.data.callerId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          request.auth.uid in resource.data.participants
        );
    }

    function callIdentityUnchanged() {
      return request.resource.data.callerId == resource.data.callerId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.chatId == resource.data.chatId &&
        request.resource.data.callType == resource.data.callType &&
        request.resource.data.liveKitRoomName == resource.data.liveKitRoomName &&
        request.resource.data.roomName == resource.data.roomName;
    }

    match /chats/{chatId} {
      // Authorize collection queries from the matched chat document itself.
      // Explicitly authorize both document reads and the
      // array-contains conversation-list query used by the client.
      allow get: if signedIn() &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;

      allow list: if signedIn() &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;

      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() >= 2 &&
        request.resource.data.participants.size() <= 100 &&
        request.auth.uid in request.resource.data.participants &&
        (
          request.resource.data.isGroup == true ||
          request.resource.data.participants.size() == 2
        );

      // Normal chat activity may update only conversation metadata.
      // Group membership has a separate, tightly-scoped path below.
      allow update: if isChatParticipant(chatId) &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageTime',
          'lastMessageSenderId',
          'unreadCount',
          'updatedAt',
          'isArchived',
          'isPinned',
          'isMuted',
          'pinnedFor',
          'mutedFor',
          'typing',
          'typingUpdatedAt',
          'deletedFor'
        ]);

      // A user may refresh only their own cached avatar fields. The canonical
      // source remains users/{uid}; no participant can rewrite another user's
      // name/photo metadata.
      allow update: if isChatParticipant(chatId) &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantDetails',
          'participantPhotos'
        ]) &&
        request.resource.data.participantDetails is map &&
        request.resource.data.participantPhotos is map &&
        (
          !resource.data.keys().hasAny(['participantDetails']) ||
          (
            resource.data.participantDetails is map &&
            request.resource.data.participantDetails.diff(resource.data.participantDetails)
              .affectedKeys().hasOnly([request.auth.uid])
          )
        ) &&
        (
          !resource.data.keys().hasAny(['participantPhotos']) ||
          (
            resource.data.participantPhotos is map &&
            request.resource.data.participantPhotos.diff(resource.data.participantPhotos)
              .affectedKeys().hasOnly([request.auth.uid])
          )
        ) &&
        request.resource.data.participantDetails[request.auth.uid].photoUrl ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoUrl &&
        request.resource.data.participantPhotos[request.auth.uid] ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoUrl;

      // Allow an authenticated user to join an existing group through its
      // invite code, without granting permission to mutate an existing member.
      allow update: if signedIn() &&
        resource.data.isGroup == true &&
        resource.data.inviteCode is string &&
        resource.data.inviteCode.size() > 0 &&
        request.resource.data.inviteCode == resource.data.inviteCode &&
        request.auth.uid in request.resource.data.participants &&
        !(request.auth.uid in resource.data.participants) &&
        request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants',
          'participantDetails',
          'memberRoles',
          'unreadCount',
          'updatedAt'
        ]) &&
        request.resource.data.memberRoles[request.auth.uid] == 'member' &&
        request.resource.data.unreadCount[request.auth.uid] == 0;

      // Group owners/admins may add exactly one new member while preserving existing membership metadata.
      allow update: if signedIn() &&
        resource.data.isGroup == true &&
        resource.data.memberRoles is map &&
        resource.data.memberRoles[request.auth.uid] in ['owner', 'admin'] &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
        request.resource.data.participants.hasOnly(resource.data.participants.concat([])) == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants',
          'participantDetails',
          'memberRoles',
          'unreadCount',
          'updatedAt'
        ]) &&
        request.resource.data.memberRoles[request.auth.uid] == resource.data.memberRoles[request.auth.uid] &&
        request.resource.data.unreadCount[request.auth.uid] == resource.data.unreadCount[request.auth.uid];

      allow delete: if false;

      match /games/{gameId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId) &&
          request.resource.data.type is string &&
          request.resource.data.players is list &&
          request.resource.data.players.size() == 1 &&
          request.resource.data.players[0] == request.auth.uid;

        allow update: if isChatParticipant(chatId) &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.players is list &&
          request.resource.data.players.size() >= 1 &&
          request.resource.data.players.size() <= 2 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players',
            'state',
            'scores',
            'currentTurn',
            'status',
            'startedAt',
            'endedAt',
            'timeLimit',
            'updatedAt'
          ]) &&
          (
            (
              request.auth.uid in resource.data.players &&
              request.resource.data.players == resource.data.players
            ) ||
            (
              resource.data.players.size() == 1 &&
              request.resource.data.players.size() == 2 &&
              request.auth.uid in request.resource.data.players &&
              resource.data.players[0] != request.auth.uid &&
              request.resource.data.players.hasAll(resource.data.players)
            )
          );

        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.chatId == chatId;

        allow update: if isChatParticipant(chatId) &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.chatId == resource.data.chatId &&
          (
            (
              resource.data.senderId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text',
                'type',
                'isEdited',
                'editedAt',
                'isDeleted',
                'deletedAt',
                'isPinned',
                'pinnedAt',
                'pinnedBy',
                'reactions',
                'deletedFor',
                'isDelivered',
                'status',
                'deliveredAt',
                'isRead',
                'readAt'
              ])
            ) ||
            (
              resource.data.senderId != request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'isPinned',
                'pinnedAt',
                'pinnedBy',
                'reactions',
                'deletedFor',
                'isDelivered',
                'status',
                'deliveredAt',
                'isRead',
                'readAt'
              ])
            )
          );

        allow delete: if false;
      }
    }

    match /callLocks/{lockId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participants;

      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants;

      allow update: if signedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeCallId',
          'status',
          'updatedAt'
        ]);

      allow delete: if signedIn() &&
        request.auth.uid in resource.data.participants;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants[0] != request.resource.data.participants[1] &&
        request.resource.data.status == 'active' &&
        request.resource.data.requestId is string &&
        getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.state == 'accepted' &&
        getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId in request.resource.data.participants &&
        getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId in request.resource.data.participants;
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'removedBy'
        ]);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId != request.auth.uid &&
        request.resource.data.state == 'pending' &&
        request.resource.data.createdAt is timestamp;
      allow update: if signedIn() &&
        resource.data.state == 'pending' &&
        ((resource.data.recipientId == request.auth.uid &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.recipientId == resource.data.recipientId &&
          request.resource.data.state in ['accepted', 'rejected']) ||
         (resource.data.senderId == request.auth.uid &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.recipientId == resource.data.recipientId &&
          request.resource.data.state == 'cancelled'));
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() &&
        resource.data.userId == request.auth.uid;

      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead',
          'readAt'
        ]);

      allow create: if false;

      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /calls/{callId} {
      allow create: if signedIn() &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.receiverId is string &&
        request.resource.data.receiverId != request.auth.uid &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.receiverId in request.resource.data.participants &&
        request.resource.data.chatId is string &&
        get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.isGroup != true &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
        request.resource.data.receiverId in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;

      allow read: if isCallParty();

      allow update: if isCallParty() &&
        callIdentityUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'isAnswered',
          'connectedAt',
          'endedAt',
          'durationSeconds',
          'endedReason',
          'busyReason',
          'metadata'
        ]);

      allow delete: if false;
    }

    match /users/{userId} {
      // Authenticated users may discover public profiles, but clients cannot
      // grant themselves an elevated role or mutate the immutable uid.
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.keys().hasAny([
          'role', 'isAdmin', 'isSuperAdmin', 'admin', 'permissions'
        ]);

      allow update: if signedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'isSuperAdmin', 'admin', 'permissions', 'uid'
        ]);

      allow delete: if false;

      match /private/{documentId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /private/tokens/fcm/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User-scoped notification history, device state, relationships, mini-app state and sync queue.
      match /notificationHistory/{documentId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.type is string &&
          request.resource.data.title is string &&
          request.resource.data.body is string;
        allow update: if signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /following/{otherUserId} { allow read: if signedIn() && (request.auth.uid == userId || request.auth.uid == otherUserId); allow create, delete: if signedIn() && request.auth.uid == userId && otherUserId != userId; allow update: if false; }
      match /followers/{followerId} { allow read: if signedIn(); allow create: if signedIn() && followerId == request.auth.uid && request.resource.data.userId == request.auth.uid; allow delete: if signedIn() && followerId == request.auth.uid; allow update: if false; }
      match /savedSocial/{contentId} { allow read, write: if signedIn() && request.auth.uid == userId; }
      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /relationships/{otherUserId} {
        allow read, write: if signedIn() && request.auth.uid == userId &&
          otherUserId != userId;
      }

      match /miniApps/{appId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /syncQueue/{queueId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }


    match /shakePresence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.active is bool &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(15, 's') &&
        request.resource.data.shakenAt is timestamp &&
        request.resource.data.shakenAt <= request.time + duration.value(5, 's') &&
        request.resource.data.shakenAt >= request.time - duration.value(5, 's');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /shakeMatches/{matchId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants[0] != request.resource.data.participants[1] &&
        get(/databases/$(database)/documents/shakePresence/$(request.resource.data.participants[0])).data.active == true &&
        get(/databases/$(database)/documents/shakePresence/$(request.resource.data.participants[1])).data.active == true &&
        get(/databases/$(database)/documents/shakePresence/$(request.resource.data.participants[0])).data.expiresAt > request.time &&
        get(/databases/$(database)/documents/shakePresence/$(request.resource.data.participants[1])).data.expiresAt > request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(45, 's');
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if signedIn() &&
        request.auth.uid in resource.data.participants;
    }


    match /socialPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 5000 &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.sharesCount == 0;
      allow update: if signedIn() && (
        (
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'mediaUrl', 'mediaType', 'updatedAt'
          ])
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likesCount', 'commentsCount', 'sharesCount', 'updatedAt'
        ])
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000;
        allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }
    match /socialReels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.videoUrl is string &&
        request.resource.data.videoUrl.size() > 0 &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.sharesCount == 0 &&
        request.resource.data.viewsCount == 0 &&
        request.resource.data.isPublished == true &&
        request.resource.data.commentsEnabled == true &&
        request.resource.data.isPinned == false;
      allow update: if signedIn() && (
        (
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'caption', 'thumbnailUrl', 'isPublished', 'commentsEnabled', 'isPinned', 'updatedAt'
          ])
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likesCount', 'commentsCount', 'sharesCount', 'viewsCount', 'updatedAt'
        ])
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          get(/databases/$(database)/documents/socialReels/$(reelId)).data.commentsEnabled != false &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000;
        allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if signedIn() &&
          resource.data.userId == request.auth.uid;
      }
    }

    match /communities/{communityId} {
      allow read: if signedIn() &&
        (resource.data.visibility == 'public' || exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)));
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.visibility == 'public' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80;
      allow update: if signedIn() &&
        request.resource.data.ownerId == resource.data.ownerId &&
        (
          resource.data.ownerId == request.auth.uid ||
          (
            exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membersCount', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /members/{memberId} {
        allow read: if signedIn() &&
          (memberId == request.auth.uid || exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)));
        allow create: if signedIn() &&
          request.auth.uid == memberId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.role is string &&
          request.resource.data.joinedAt is timestamp &&
          getAfter(/databases/$(database)/documents/communities/$(communityId)).data.visibility == 'public' &&
          (request.resource.data.role == 'member' ||
           (request.resource.data.role == 'owner' &&
            getAfter(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid));
        allow update: if signedIn() && resource.data.role == 'owner' && request.auth.uid == memberId;
        allow delete: if signedIn() && request.auth.uid == memberId;
      }

      match /channels/{channelId} {
        allow read: if signedIn() &&
          exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        allow create: if signedIn() &&
          exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.communityId == communityId;
        allow update: if signedIn() &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if false;

        match /posts/{postId} {
          allow read: if signedIn() &&
            exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
          allow create: if signedIn() &&
            exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) &&
            request.resource.data.authorId == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 4000;
          allow update: if signedIn() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId;
          allow delete: if false;
        }
      }
    }

    // Stories and their per-user interactions.
    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.expiresAt is timestamp;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /views/{viewerId} {
        allow read: if signedIn();
        allow create, update: if signedIn() &&
          viewerId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }

      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          reactionId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid;
        allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Per-user saved document library.
    match /document_library/{docId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetUserId is string &&
        request.resource.data.targetUserId != request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    match /voiceRooms/{roomId} {
      // Voice rooms are discoverable by authenticated users. The client
      // queries only active rooms; membership remains protected separately.
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.roomName is string &&
        request.resource.data.active == true;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/voiceRooms/$(roomId)).data.active == true;
        allow create: if signedIn() &&
          memberId == request.auth.uid &&
          get(/databases/$(database)/documents/voiceRooms/$(roomId)).data.active == true &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.role is string &&
          (
            request.resource.data.role == 'listener' ||
            (
              request.resource.data.role == 'host' &&
              get(/databases/$(database)/documents/voiceRooms/$(roomId)).data.ownerId == request.auth.uid
            )
          );
        allow delete: if signedIn() && memberId == request.auth.uid;
        allow update: if signedIn() &&
          memberId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.role == resource.data.role;
      }
    }

    // Business profiles are keyed by the owner's UID and are publicly discoverable only to signed-in users.
    match /communityInvites/{inviteId} {
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId != request.auth.uid &&
        request.resource.data.communityId is string &&
        request.resource.data.state == 'pending';
      allow read: if signedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt']);
      allow delete: if false;
    }

    match /voiceRoomInvites/{inviteId} {
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId != request.auth.uid &&
        request.resource.data.roomId is string &&
        request.resource.data.state == 'pending';
      allow read: if signedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt']);
      allow delete: if false;
    }

    match /businessProfiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if signedIn() && resource.data.active == true;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() >= 2 &&
        request.resource.data.category.size() <= 60;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    // Direct game challenges are separate from the per-chat game session.
    // Both sender and recipient need to be able to create/read/update only
    // their own challenge documents; this is the operation that previously
    // surfaced as cloud_firestore/permission-denied.
    match /gameChallenges/{challengeId} {
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.gameId is string &&
        request.resource.data.status == 'pending';
      allow read: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid) &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.gameId == resource.data.gameId &&
        request.resource.data.status in ['pending', 'accepted', 'rejected', 'cancelled'];
      allow delete: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /gameLeaderboard/{gameId} {
      allow read: if signedIn();

      match /scores/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() &&
          userId == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.score is int &&
          request.resource.data.score >= 0;
        allow delete: if false;
      }

      match /players/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() &&
          userId == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.totalScore is int &&
          request.resource.data.gamesPlayed is int &&
          request.resource.data.wins is int &&
          request.resource.data.bestScore is int &&
          request.resource.data.totalScore >= 0 &&
          request.resource.data.gamesPlayed >= 0 &&
          request.resource.data.wins >= 0 &&
          request.resource.data.bestScore >= 0;
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read, write: if false;
    }
  }
}
